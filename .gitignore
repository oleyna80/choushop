# Codex workflow layer is synchronized through Git by default.
# Keep private runtime artifacts, secrets, and machine-specific state out of it.
.codex/*
!.codex/
!.codex/config.toml
!.codex/write-gate.md
!.codex/AGENTS.md
!.codex/critic.md
!.codex/instructions.md
!.codex/hooks/
