.agent/**/*.backup-*
.claude/backups/
.claude/plans/
.claude/plugins/
.claude/shell-snapshots/
.claude/.last-cleanup
.claude/settings.local.json
!.claude/settings.local.json.example

# Agent/development workflow docs are synchronized through Git by default.
# Keep only private runtime artifacts, secrets, and machine-specific state out
# of the repository.
!docs/public/
!docs/public/**

